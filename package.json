{
	"name": "@ragedpanda/tx-retry",
	"version": "0.1.1",
	"description": "Retry a whole database transaction on serialization failures, deadlocks and busy errors, with backoff, AbortSignal and afterCommit hooks. Works with pg, Kysely, Drizzle, Prisma, TypeORM and SQLite",
	"license": "MIT",
	"author": "Ankur Dubey (https://github.com/RagedPanda)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RagedPanda/tx-retry.git"
	},
	"type": "module",
	"main": "./dist/cjs/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
		"bench": "node bench/index.ts",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"keywords": [
		"transaction",
		"retry",
		"serializable",
		"serialization-failure",
		"deadlock",
		"40001",
		"40P01",
		"SQLITE_BUSY",
		"postgres",
		"pg",
		"mysql",
		"sqlite",
		"kysely",
		"drizzle",
		"prisma",
		"typeorm",
		"after-commit",
		"backoff"
	],
	"devDependencies": {
		"@electric-sql/pglite": "0.5.16",
		"@electric-sql/pglite-socket": "0.2.19",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "^26.6.6",
		"@types/pg": "8.23.1",
		"better-sqlite3": "12.11.1",
		"drizzle-orm": "0.45.4",
		"kysely": "0.29.9",
		"p-retry": "9.0.0",
		"pg": "8.23.1",
		"reflect-metadata": "0.2.2",
		"typeorm": "1.1.3",
		"typescript": "^7.0.2"
	}
}
